#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec3 position;
    vec4 color;
    float size;
};

layout(set = 1, binding = 0) buffer Buffer {
    Particle data[];
};

layout(set = 2, binding = 0) uniform Uniform {
    uint count;
    float time;
};

float hash(uint n) {
    uint state = n * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return float(word) / 4294967295.0;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= count) {
        return;
    }
    float baseRadius = 0.05;
    float radiusIncrement = 0.7;
    float percent = float(index) / 100000.0;

    float curve = pow(percent, 1.5);
    uint ringIndex = uint(curve * 100.0);
    ringIndex = min(ringIndex, 99U);

    float randRadius = hash(index * 3u + 0u) - 0.5;
    float randAngle = hash(index * 3u + 1u) - 0.5;

    float radius = baseRadius + (ringIndex * radiusIncrement) + (randRadius * mix(1.0, 12.0, float(ringIndex) / 100.0));

    float armOffset = float(index % 8u) * (6.283185 / float(8u));
    float spiralTwist = 0.05;
    float angle = armOffset + (float(ringIndex) * spiralTwist) + time + (randAngle * 1.3);

    vec2 pos = vec2(cos(angle) * radius, sin(angle) * radius);
    float squash = mix(0.65, 1.0, smoothstep(0.5, 1.0, curve));
    pos.y *= squash;

    float baseTilt = 0.0;
    float tiltIncrement = 0.045;
    float tiltAngle = baseTilt + (tiltIncrement * ringIndex);

    float s = sin(tiltAngle);
    float c = cos(tiltAngle);
    pos = vec2(pos.x * c - pos.y * s, pos.x * s + pos.y * c);

    vec3 finalPos = vec3(pos, 0.0);

    Particle particle;
    particle.position = finalPos;

    float t = float(ringIndex) / 99.9;
    vec3 coreColor = vec3(1.0, 0.35, 0.0);
    vec3 middleColor = vec3(0.55, 0.75, 1.0);
    vec3 color = mix(
        coreColor,
        middleColor,
        smoothstep(0.0, 0.75, t)
    );
    particle.color = vec4(color, 1.0);
    particle.size = 1.0;

    data[index] = particle;
}
